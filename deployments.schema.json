{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoolPass deployments",
  "type": "object",
  "required": ["network", "accounts", "contracts", "transactions"],
  "properties": {
    "network": {
      "type": "object",
      "required": ["name", "rpcUrl", "passphrase", "protocolVersion"],
      "properties": {
        "name": { "const": "testnet" },
        "rpcUrl": { "type": "string", "format": "uri" },
        "passphrase": { "const": "Test SDF Network ; September 2015" },
        "protocolVersion": { "type": "integer", "minimum": 25 }
      },
      "additionalProperties": false
    },
    "accounts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["publicKey"],
        "properties": { "publicKey": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" } },
        "additionalProperties": false
      }
    },
    "contracts": { "type": "object" },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "contractId",
          "poolToken",
          "merkleDepth",
          "perInvestorCapPublic",
          "issuer",
          "vk",
          "gateDescription"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "contractId": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
          "poolToken": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
          "merkleDepth": { "type": "integer", "minimum": 1, "maximum": 16 },
          "perInvestorCapPublic": { "type": "string", "pattern": "^\\d+$" },
          "issuer": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" },
          "vk": { "type": "string" },
          "gateDescription": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "transactions": { "type": "object" }
  },
  "additionalProperties": false
}
