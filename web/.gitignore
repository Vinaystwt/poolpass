# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ZK prover artifacts — must ship to Vercel. Root .gitignore globally ignores
# *.wasm; re-include the committed, sha256-verified prover wasm here.
!public/zk/poolpass.wasm
